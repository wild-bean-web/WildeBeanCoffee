# Manager runtime (never reuse storefront credentials)
NODE_ENV=development
MANAGER_APP_URL=http://localhost:3001
MANAGER_TIMEZONE=America/New_York

# Dedicated manager PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/wild_bean_manager
DATABASE_POOL_MAX=10
DATABASE_PREPARE_STATEMENTS=false

# Invite-only Supabase authentication
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MANAGER_BOOTSTRAP_OWNER_EMAIL=
MANAGER_BOOTSTRAP_OWNER_NAME=Wild Bean Owner
MANAGER_BOOTSTRAP_AUTH_USER_ID=

# Private document storage
DOCUMENT_STORAGE_PROVIDER=supabase
DOCUMENT_STORAGE_BUCKET=manager-documents
DOCUMENT_MAX_BYTES=15728640

# Dedicated inbound invoice email. Brand secret stays here; each location mailbox
# is saved in Settings (invoice email + Postmark hash).
POSTMARK_INBOUND_SECRET=

# Optional AES key for store Clover tokens stored on the location.
# When unset, a key is derived from DATABASE_URL.
MANAGER_CREDENTIALS_KEY=

# Managed document extraction
DOCUMENT_AI_PROVIDER=azure
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Brand Clover Platform settings (environment, webhook, scopes).
# Merchant ID and API token bootstrap the first store until you save them in Settings.
CLOVER_MANAGER_ENVIRONMENT=sandbox
CLOVER_MANAGER_WEBHOOK_SECRET=
CLOVER_MANAGER_PLATFORM_WEBHOOK_AUTH_CODE=
CLOVER_MANAGER_READ_SCOPES=MERCHANT_R,ORDERS_R,PAYMENTS_R,INVENTORY_R
CLOVER_MANAGER_REQUEST_TIMEOUT_MS=10000
CLOVER_MANAGER_MAX_RETRIES=3
CLOVER_MANAGER_PAGE_SIZE=200

# Signed storefront outbox events
STOREFRONT_OUTBOX_SECRET=

# Scheduled job authentication
MANAGER_CRON_SECRET=

# Error reporting (optional)
SENTRY_DSN=

# Development only. Production refuses to start when enabled.
MANAGER_DEMO_MODE=false
