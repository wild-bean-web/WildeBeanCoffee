# Optional overrides when running npm run seed:test (loads this file with --test).
# Local Express (npm run dev) uses server/.env only.
#
# seed:test refreshes catalog only (products, menu, locations, modifiers)
# and preserves users + orders on wildcoffeebean_TEST.

MONGODB_TEST_URI=mongodb+srv://USER:PASS@YOUR-CLUSTER.mongodb.net/wildcoffeebean_TEST?retryWrites=true&w=majority
